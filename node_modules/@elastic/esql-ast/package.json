{
  "name": "@elastic/esql-ast",
  "version": "4.34.0",
  "author": "Kibana ES|QL team",
  "description": "ES|QL AST builder.",
  "license": "Elastic-2.0",
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "NOTICE.txt",
    "LICENSE.txt",
    "lib"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elastic/esql-js.git"
  },
  "dependencies": {
    "@elastic/esql-definitions": "^4.34.0",
    "@elastic/esql-grammar": "^4.34.0",
    "@elastic/esql-promql-grammar": "^4.34.0",
    "@elastic/esql-types": "^4.34.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "25.2.3",
    "jest": "30.4.2",
    "ts-jest": "29.4.11",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "build:watch": "tsup --watch --onSuccess \"tsc -p tsconfig.build.json\"",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  }
}